<Window x:Class="AgentPager.Bridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentPager Bridge" Width="760" Height="560"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#090D12" Foreground="#E8F4FF"
        Icon="Assets/agentpager-icon.png">
    <Window.Resources>
        <FontFamily x:Key="PixelFont">./Assets/#Fusion Pixel 12px Prop zh_hans</FontFamily>
        <SolidColorBrush x:Key="Surface" Color="#111923"/>
        <SolidColorBrush x:Key="Border" Color="#263747"/>
        <SolidColorBrush x:Key="Cyan" Color="#35E6E0"/>
        <SolidColorBrush x:Key="Muted" Color="#B7C7D8"/>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E8F4FF"/>
            <Setter Property="Background" Value="#182432"/>
            <Setter Property="BorderBrush" Value="{StaticResource Cyan}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="#182432"/>
            <Setter Property="Foreground" Value="#E8F4FF"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#E8F4FF"/>
                        <Setter Property="Background" Value="#111923"/>
                        <Setter Property="Padding" Value="9,7"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <TextBlock Text="{Binding Content.Label,
                                            RelativeSource={RelativeSource AncestorType=ComboBoxItem}}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#263747"/>
                                            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1A3440"/>
                                            <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          Foreground="{TemplateBinding Foreground}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="9,6" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Left"
                                                                  Content="{Binding SelectedItem,
                                                                      RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                                    <ContentPresenter.ContentTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Label}"/>
                                                        </DataTemplate>
                                                    </ContentPresenter.ContentTemplate>
                                                </ContentPresenter>
                                                <TextBlock Grid.Column="1" Text="▼" FontSize="10"
                                                           Foreground="{StaticResource Cyan}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#203041"/>
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush"
                                                        Value="{StaticResource Cyan}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="#111923" BorderBrush="{StaticResource Cyan}"
                                        BorderThickness="1"
                                        MinWidth="{Binding PlacementTarget.ActualWidth,
                                            RelativeSource={RelativeSource AncestorType=Popup}}">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E8F4FF"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontFamily" Value="{StaticResource PixelFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#E8F4FF"/>
            <Setter Property="Background" Value="#111923"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="22,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Margin="0,0,-1,0"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter x:Name="HeaderContent" ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#182432"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{StaticResource Cyan}"/>
                                <Setter TargetName="HeaderContent" Property="TextElement.Foreground"
                                        Value="{StaticResource Cyan}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#203041"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#7C8C9C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Image Width="54" Height="54" Source="Assets/agentpager-icon.png"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="AGENTPAGER BRIDGE" FontFamily="{StaticResource PixelFont}"
                           FontSize="20" FontWeight="Bold"/>
                <TextBlock x:Name="ServiceStatusText" Margin="0,5,0,0"
                           Foreground="{StaticResource Cyan}"/>
            </StackPanel>
            <Border Grid.Column="3" Padding="12,8" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PHONE "/>
                    <TextBlock x:Name="PhoneCountText" Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <TabControl Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}">
            <TabItem Header="连接">
                <Grid Margin="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="28"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="250" Height="250" Padding="12" Background="White"
                            VerticalAlignment="Top" BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <Image x:Name="PairingQrImage" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="扫描配对" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Cyan}"/>
                        <TextBlock Margin="0,8,0,16" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="用 Android AgentPager 扫描左侧二维码。首次启动时，请在 Windows 防火墙提示中只允许“专用网络”访问。"/>
                        <TextBlock Text="局域网地址" Margin="0,0,0,6"/>
                        <DockPanel>
                            <ComboBox x:Name="NetworkCombo" MinWidth="285" DisplayMemberPath="Label"
                                      SelectedValuePath="Address" SelectionChanged="NetworkCombo_SelectionChanged"/>
                            <Button Content="刷新" Margin="8,0,0,0" Click="RefreshNetworks_Click"/>
                        </DockPanel>
                        <TextBlock Text="配对文本" Margin="0,16,0,6"/>
                        <TextBox x:Name="PairingTextBox" Height="72" Padding="8"
                                 Background="#090D12" Foreground="#C6D6E5"
                                 BorderBrush="{StaticResource Border}" TextWrapping="Wrap"
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                        <Button Content="复制配对文本" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="CopyPairing_Click"/>
                        <CheckBox x:Name="StartupCheckBox" Content="登录 Windows 时启动"
                                  Margin="0,18,0,0" Checked="StartupCheckBox_Changed"
                                  Unchecked="StartupCheckBox_Changed"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="CODEX">
                <StackPanel Margin="28">
                    <TextBlock Text="Codex 生命周期 Hook" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource Cyan}"/>
                    <Border Margin="0,18,0,0" Padding="18" Background="#090D12"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="配置状态"/>
                                <TextBlock x:Name="HookStatusText" DockPanel.Dock="Right"
                                           Foreground="{StaticResource Cyan}" FontWeight="Bold"/>
                            </DockPanel>
                            <DockPanel Margin="0,12,0,0">
                                <TextBlock Text="最近事件"/>
                                <TextBlock x:Name="LastHookText" DockPanel.Dock="Right" Foreground="{StaticResource Muted}"/>
                            </DockPanel>
                            <TextBlock Margin="0,18,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="安装会保留已有 Hook 并创建备份。写入配置后，请在 Codex 中运行 /hooks，审核并信任 AgentPager Hook；未信任前 Codex 会跳过它。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="安装或修复" Click="InstallHook_Click"/>
                                <Button Content="卸载" BorderBrush="#FF5D72" Click="UninstallHook_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,18,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Bridge 不在线时普通 Hook 自动放行，不会阻塞 Codex。手机批准/拒绝只对真实 PermissionRequest 生效。"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="CLAUDE">
                <StackPanel Margin="28">
                    <TextBlock Text="Claude Code 生命周期 Hook" FontSize="18" FontWeight="Bold"
                               Foreground="#A78BFA"/>
                    <Border Margin="0,18,0,0" Padding="18" Background="#090D12"
                            BorderBrush="{StaticResource Border}" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="配置状态"/>
                                <TextBlock x:Name="ClaudeHookStatusText" DockPanel.Dock="Right"
                                           Foreground="#A78BFA" FontWeight="Bold"/>
                            </DockPanel>
                            <TextBlock Margin="0,18,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="向 ~/.claude/settings.json 写入生命周期 Hook，覆盖开始、工具、权限、完成等事件；保留现有 Hook 并自动备份。安装后 Claude Code 首次触发 Hook 时会询问是否信任。"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                <Button Content="安装或修复" Click="InstallClaudeHook_Click"/>
                                <Button Content="卸载" BorderBrush="#FF5D72" Click="UninstallClaudeHook_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Margin="0,18,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                               Text="Bridge 不在线时 Hook 自动放行，不会阻塞 Claude Code。"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="OTHERS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="28">
                        <TextBlock Text="其他客户端 Hook" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource Cyan}"/>
                        <TextBlock Margin="0,12,0,0" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                   Text="兼容 Claude Code Hook 协议的客户端。只有检测到客户端已安装才能写入，改写前自动备份并保留你的既有 Hook。"/>
                        <StackPanel x:Name="IntegrationList" Margin="0,18,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="4" Padding="11,8" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Border}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="打开日志目录" Margin="12,0,0,0" Click="OpenLogs_Click"/>
                <TextBlock x:Name="DiagnosticText" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
